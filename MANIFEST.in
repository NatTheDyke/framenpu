include evidence/fault-unwind-validation.json
include evidence/resident-gemm-validation.json
include evidence/convolution-validation.json
include evidence/landmark-validation.json
include evidence/resident-landmark-validation.json
include evidence/depthwise-gather-validation.json
include evidence/resident-cache-validation.json
include evidence/resident-link-validation.json
include evidence/resident-link-fast-validation.json
include evidence/resident-power-validation.json
global-exclude *.pyc
include .gitignore .gitattributes
recursive-include .github *.yml
include evidence/native-time-profile.json
include evidence/depthwise-profile.json
include evidence/depthwise-arithmetic-profile.json
