include README.md LICENSE THIRD_PARTY_NOTICES.md
include CONTRIBUTING.md SECURITY.md CHANGELOG.md
recursive-include docs *.md
recursive-include tools *.py
recursive-include tests *.py
recursive-include src/framenpu/data *.json *.so
recursive-include src/framenpu/host *.c *.h
recursive-include src/framenpu/manifests *.json *.md
exclude HANDOFF.md
prune handoff-tools
global-exclude *.pyc
include .gitignore .gitattributes
recursive-include .github *.yml
