include README.md LICENSE THIRD_PARTY_NOTICES.md
include CONTRIBUTING.md SECURITY.md CHANGELOG.md
recursive-include docs *.md
recursive-include tools *.py
recursive-include examples *.py *.c *.param *.fjob *.fnpu *.json
recursive-include tests *.py *.c *.S
exclude HANDOFF.md
prune handoff-tools
include handoff-tools/build_mw.py
recursive-include src/framenpu/data *.bin *.json
recursive-include src/framenpu/sdk *.h *.S *.c *.ld
include evidence/validation.json
include evidence/dispatch-validation.json
include evidence/hmx-dispatch-validation.json
include evidence/multitile-validation.json
include evidence/hvx-validation.json
include evidence/readback-validation.json
include evidence/hmx-multi-validation.json
include evidence/hmx-accumulator-validation.json
include evidence/hmx-baseline-validation.json
include evidence/hmx-cache-validation.json
include evidence/hmx-batch2-validation.json
include evidence/fault-unwind-validation.json
global-exclude *.pyc
include .gitignore .gitattributes
recursive-include .github *.yml
