+        self.assertEqual([r[4]["batch_crops"] for r in out], [3, 3, 3, 1])
+        self.assertEqual([r[4]["request_crops"] for r in out], [3, 3, 3, 1])
+        self.assertEqual([r[4]["dsp_body_ms"] for r in out], [0.0] * 4)
